# Опционально: скопируйте в .env в корне — Docker Compose подхватит переменные.
# Без файла всё работает с дефолтами из docker-compose.yml.

# PostgreSQL
POSTGRES_DB=restaurants_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres

# Backend
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
NODE_ENV=production

# Администратор (создаётся при старте backend)
ADMIN_EMAIL=admin@restaurants.by
ADMIN_PASSWORD=admin123
ADMIN_NAME=Администратор

# Яндекс.Карты (опционально, для сборки frontend)
VITE_YANDEX_MAPS_API_KEY=
YANDEX_MAPS_API_KEY=
YANDEX_GEOSUGGEST_API_KEY=
